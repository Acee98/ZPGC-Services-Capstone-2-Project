<?xml version="1.0" encoding="UTF-8"?>
<!-- Azure App Service (Windows) — route PHP entry and protect local secrets. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="pages/login_signup.php" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <rule name="BlockEnvFiles" stopProcessing="true">
          <match url=".*\.(env)$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="BlockMailEnv" stopProcessing="true">
          <match url="logic/mail\.env" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".venv" />
          <add segment="docs" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
