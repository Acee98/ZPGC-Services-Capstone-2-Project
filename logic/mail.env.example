# Copy this file to logic/mail.env and fill in your real values.
# Never paste the App Password into chat.
# On Azure / Hostinger, prefer Application settings with the same names
# (they override this file). See DEPLOY.md.
#
# Outlook / Microsoft 365 (TSU):
#   MAIL_HOST=smtp.office365.com
# Gmail (legacy option):
#   MAIL_HOST=smtp.gmail.com

MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your.name@tsu.edu.ph
MAIL_PASSWORD=your-app-password-or-account-password
MAIL_FROM=your.name@tsu.edu.ph
MAIL_FROM_NAME=ZPGC Services
# Must match the public site URL (no trailing slash).
# Local:  http://localhost/CP2_V1.6
# Azure:  https://YOUR-APP.azurewebsites.net
# Hostinger: https://your-domain.com
MAIL_APP_URL=http://localhost/CP2_V1.6
