{
  "title": "ZPGC Kaggle ticket classification model comparison",
  "protocol": {
    "n": 200,
    "seed": 42,
    "dataset": "ai/data/kaggle_tickets_multi_lang.csv",
    "filters": "language=en; queues=IT Support, Product Support, Service Outages and Maintenance, Technical Support",
    "gold_labels": "Heuristically mapped from queue/tags/text into ZPGC category/priority (same for all models)",
    "note": "Live site and ai/.env remain on gpt-5.6-luna. These runs used process-only --model overrides."
  },
  "models": [
    {
      "model": "gpt-4.1-nano",
      "role": "Cheapest suggested mini/nano",
      "report": "ai/data/benchmark_gpt41_nano_report.json",
      "accuracy": {
        "category": 0.605,
        "priority": 0.43,
        "category_and_priority": 0.25
      },
      "openai_errors_or_fallbacks": 18,
      "approx_price_per_1m_tokens": { "input_usd": 0.10, "output_usd": 0.40 },
      "notes": "Best category accuracy in this suite. 18/200 calls fell back to keywords."
    },
    {
      "model": "gpt-4.1-mini",
      "role": "Balanced cheap quality",
      "report": "ai/data/benchmark_gpt41_mini_report.json",
      "accuracy": {
        "category": 0.575,
        "priority": 0.455,
        "category_and_priority": 0.23
      },
      "openai_errors_or_fallbacks": 0,
      "approx_price_per_1m_tokens": { "input_usd": 0.40, "output_usd": 1.60 },
      "notes": "Stable (0 fallbacks). Best priority accuracy among OpenAI models tested."
    },
    {
      "model": "gpt-5.6-luna",
      "role": "Current live / .env model (prior run)",
      "report": "ai/data/benchmark_luna_report.json",
      "accuracy": {
        "category": 0.57,
        "priority": 0.39,
        "category_and_priority": 0.2
      },
      "openai_errors_or_fallbacks": 0,
      "approx_price_per_1m_tokens": { "input_usd": null, "output_usd": null },
      "notes": "Campus/live model kept unchanged. Middle category; weakest priority in this suite."
    },
    {
      "model": "gpt-5-mini",
      "role": "Newer GPT-5 family mini",
      "report": "ai/data/benchmark_gpt5_mini_report.json",
      "accuracy": {
        "category": 0.565,
        "priority": 0.43,
        "category_and_priority": 0.22
      },
      "openai_errors_or_fallbacks": 0,
      "approx_price_per_1m_tokens": { "input_usd": 0.25, "output_usd": 2.00 },
      "notes": "Needed OPENAI_MAX_COMPLETION_TOKENS=800 for this run only (default 200 leaves empty/invalid JSON). Not applied to live .env."
    },
    {
      "model": "gpt-4o-mini",
      "role": "Classic cheap default",
      "report": "ai/data/benchmark_gpt4o_mini_report.json",
      "accuracy": {
        "category": 0.545,
        "priority": 0.445,
        "category_and_priority": 0.24
      },
      "openai_errors_or_fallbacks": 1,
      "approx_price_per_1m_tokens": { "input_usd": 0.15, "output_usd": 0.60 },
      "notes": "Solid and cheap; below nano/4.1-mini on category in this remapped test."
    },
    {
      "model": "keyword_baseline",
      "role": "Offline fallback",
      "report": "ai/data/benchmark_keyword_n200_seed42.json",
      "accuracy": {
        "category": 0.515,
        "priority": 0.405,
        "category_and_priority": 0.205
      },
      "openai_errors_or_fallbacks": 0,
      "approx_price_per_1m_tokens": { "input_usd": 0, "output_usd": 0 },
      "notes": "Same n=200 seed=42 sample for fair compare."
    }
  ],
  "ranking_by_category": [
    "gpt-4.1-nano",
    "gpt-4.1-mini",
    "gpt-5.6-luna",
    "gpt-5-mini",
    "gpt-4o-mini",
    "keyword_baseline"
  ],
  "ranking_by_priority": [
    "gpt-4.1-mini",
    "gpt-4o-mini",
    "gpt-4.1-nano",
    "gpt-5-mini",
    "keyword_baseline",
    "gpt-5.6-luna"
  ],
  "paper_takeaway": "On this remapped Kaggle protocol, cheap gpt-4.1-nano / gpt-4.1-mini match or beat Luna on category while staying within a ~$5 budget. Absolute percentages are still limited by heuristic gold labels, not campus human labels."
}
