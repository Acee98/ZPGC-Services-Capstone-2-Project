<?xml version="1.0" encoding="UTF-8"?>
<!-- Azure App Service (Windows) — route PHP entry and protect local secrets. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="pages/login_signup.php" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <rule name="BlockEnvFiles" stopProcessing="true">
          <match url=".*\.(env)$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="BlockMailEnv" stopProcessing="true">
          <match url="logic/mail\.env" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="BlockAiProbes" stopProcessing="true">
          <match url="^ai/(probe_|benchmark_|eval_|rebuild_).*" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="BlockAiData" stopProcessing="true">
          <match url="^ai/data/.*" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="BlockUploadsListing" stopProcessing="true">
          <match url="^uploads/.*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="BlockUploadPhp" stopProcessing="true">
          <match url="^uploads/.*\.(php|phtml|phar|cgi|pl)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".venv" />
          <add segment="docs" />
          <add segment="agent-transcripts" />
          <add segment="vendor" />
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="3145728" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
